# Backend
IVQC_APP_NAME=industrial-vision-qc-backend
IVQC_ENVIRONMENT=development
IVQC_LOG_LEVEL=INFO
# dev database; tests use industrialvision_test and must never touch this one
IVQC_DATABASE_URL=postgresql+asyncpg://vision_qc:vision_qc@127.0.0.1:5433/vision_qc
IVQC_INFERENCE_SERVICE_URL=http://127.0.0.1:8100
IVQC_INFERENCE_TIMEOUT_SECONDS=30
IVQC_MAX_UPLOAD_BYTES=10485760
# Required in staging/production; development may leave empty for one process.
IVQC_REDIS_URL=redis://127.0.0.1:6380/0
IVQC_SHARED_STATE_PREFIX=ivqc

# Inference service
IVQC_WEIGHTS=../model-training/runs/neu-det-yolov8s-baseline-2/weights/best.pt
IVQC_MODEL_VERSION=phase1-baseline
IVQC_DEVICE=

# ---- Phase 7 industrial integration (OPT-IN) ----
# Default is DISABLED: the development environment runs in NOT_INTEGRATED
# (the desired command is computed and recorded, the PLC adapter is never
# invoked, and no field state is claimed). To enable the industrial closed
# loop, run the simulators (python -m simulator.plc_simulator /
# mes_simulator) and flip both flags to true.
IVQC_PLC_ENABLED=false
IVQC_MES_ENABLED=false
# PLC transport (http | opcua)
IVQC_PLC_ADAPTER_TYPE=http
IVQC_PLC_URL=http://127.0.0.1:8501
IVQC_PLC_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:8503
IVQC_PLC_TIMEOUT_SECONDS=2
IVQC_PLC_MAX_RETRIES=2
IVQC_MES_URL=http://127.0.0.1:8502
IVQC_MES_TIMEOUT_SECONDS=2
IVQC_MES_MAX_RETRIES=2


# ---- Phase 9 Quality Copilot (LLM) ----
# Provider abstraction: "fake" runs the deterministic offline provider
# (tests/E2E/eval, no paid API); "openai" talks to any OpenAI-compatible
# endpoint (vLLM / Ollama / cloud). The API key MUST come from the
# environment, never from git.
IVQC_LLM_PROVIDER=fake
IVQC_LLM_BASE_URL=http://127.0.0.1:11434/v1
IVQC_LLM_MODEL=qwen2.5-7b-instruct
IVQC_LLM_API_KEY=
IVQC_LLM_TIMEOUT_SECONDS=30
IVQC_LLM_MAX_TOOL_CALLS=6
IVQC_LLM_MAX_TURNS=3
