FROM pytorch/pytorch:2.13.0-cuda13.0-cudnn9-runtime@sha256:db80a41f8428644cebcb3d75b0b62df334ab6c0e75785951eb25f48bfbd42407

ARG APP_UID=10001
ARG APP_GID=10001

RUN groupadd --gid ${APP_GID} d3review \
    && useradd --uid ${APP_UID} --gid ${APP_GID} --create-home d3review \
    && python -m pip install --break-system-packages --no-cache-dir pip==26.1.2 setuptools==83.0.0 \
    && python -m pip install --break-system-packages --no-cache-dir \
       numpy==2.2.6 \
       pydantic==2.13.4 \
       pillow==12.3.0

COPY packages/vision-contract /opt/vision-contract
RUN python -m pip install --break-system-packages --no-cache-dir /opt/vision-contract

COPY inference-service/scripts/d3_release_container_review.py /opt/d3-review/container_review.py

ENV D3_PROJECT_ROOT=/workspace \
    D3_REVIEW_PORT=8080 \
    HOME=/home/d3review \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER d3review:d3review
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=90s --retries=6 \
  CMD ["python", "/opt/d3-review/container_review.py", "healthcheck"]

ENTRYPOINT ["python", "/opt/d3-review/container_review.py"]
CMD ["serve"]
